# 运行时产物（游戏目录里的备份，不入库）
*.orig
*.bak
*.bak_*
steam_settings.bak_*
steam_settings/

# 诊断输出（仓库根目录的临时诊断，sync/diag 下的要入库）
/diag-*.txt
/diag-*.log
/PktMon.etl
/out.txt

# PowerShell 日志
*.log

# macOS
.DS_Store
._*

# 编辑器
.vscode/
.idea/
*.swp
*~

# 同步目录：只忽略临时文件和超大文件，其余正常入库
sync/**/*.tmp
sync/**/*.part
sync/**/~$*
sync/saves/**/*.db.tmp

# 研究用二进制（体积大，不入库）
research/artifacts/*.dylib
research/artifacts/*.dll
research/artifacts/*.so
research/artifacts/*.7z
research/artifacts/*.tar.bz2
